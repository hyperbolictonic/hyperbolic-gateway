{
  "name": "kuang-grade-mark-eleven",
  "version": "1.1.1",
  "license": "MIT",
  "description": "Stateful Visual Matrix Navigator (Electron Chassis + Focus-Independent Telemetry Engine + Orthogonal Primitive Layer)",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "tsc && vite build && npm run build:mcp",
    "build:mcp": "npx esbuild src/mcp/bridge-server.ts --bundle --platform=node --format=cjs --outfile=bin/mcp-server.cjs && npx esbuild src/mcp/bridge-server.ts --bundle --platform=node --format=cjs --outfile=scripts/mcp-server.js",
    "build:pack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "build:win:all": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:linux:appimage": "npm run build && electron-builder --linux AppImage --x64",
    "build:linux:deb": "npm run build && electron-builder --linux deb --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:dist:all": "npm run build && electron-builder -mwl",
    "test:mcp": "node scripts/test-client.js",
    "test:mcp:all": "node scripts/test-all-mcp-tools.js",
    "test:harvest": "node scripts/test-harvest-regression.mjs",
    "test:primitives": "node scripts/test-primitives.mjs",
    "test:mcp:primitives": "node scripts/test-mcp-primitives.mjs",
    "test:mcp:contract": "node scripts/test-mcp-contract.mjs",
    "test:mcp:surface": "node scripts/test-mcp-surface.mjs",
    "test:focus": "node scripts/test-input-focus-independence.mjs",
    "test:cortex:bookmarks": "node scripts/test-bookmarks-search.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "mcp",
    "electron",
    "browser",
    "multimodal",
    "ai-agent",
    "cyberpunk"
  ],
  "author": "",
  "dependencies": {
    "@lancedb/lancedb": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.1.2",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/turndown": "^5.0.6",
    "daisyui": "^5.7.50",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "electron-winstaller"
    ]
  }
}
