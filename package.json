{
  "name": "kuang-grade-mark-eleven",
  "version": "1.4.6",
  "license": "MIT",
  "description": "Stateful Visual Matrix Navigator (Electron Chassis + Focus-Independent Telemetry Engine + Orthogonal Primitive Layer)",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "tsc && vite build && npm run build:mcp",
    "build:mcp": "npx esbuild src/mcp/bridge-server.ts --bundle --platform=node --format=cjs --outfile=bin/mcp-server.cjs && npx esbuild src/mcp/bridge-server.ts --bundle --platform=node --format=cjs --outfile=scripts/mcp-server.js && npx esbuild src/mcp/wrap-server.ts --bundle --platform=node --format=cjs --outfile=bin/wrap-server.cjs",
    "build:pack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "build:win:all": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:linux:appimage": "npm run build && electron-builder --linux AppImage --x64",
    "build:linux:deb": "npm run build && electron-builder --linux deb --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:dist:all": "npm run build && electron-builder -mwl",
    "check:no-local-paths": "node scripts/check-no-local-paths.mjs",
    "test:recipe": "node --test packages/recipe/test/render.test.ts packages/recipe/test/derive.test.ts packages/recipe/test/validate.test.ts",
    "test:wrap": "node --test scripts/test-wrap-core.mjs",
    "test:research:settings": "node --test scripts/test-research-settings.mjs",
    "test:crawl:pool": "node --test scripts/test-crawl-pool.mjs",
    "typecheck:recipe": "tsc -p packages/recipe/tsconfig.json",
    "fix:local-paths": "node scripts/check-no-local-paths.mjs --fix",
    "test:mcp": "node scripts/test-client.js",
    "test:mcp:all": "node scripts/test-all-mcp-tools.js",
    "test:harvest": "node scripts/test-harvest-regression.mjs",
    "test:markdown": "node scripts/test-markdown-presentation.mjs",
    "test:act": "node scripts/test-act-shadow.mjs",
    "test:decide": "node scripts/test-decide.mjs",
    "test:consent": "node scripts/test-consent-sweep.mjs",
    "drive": "node scripts/drive-example.mjs",
    "bench:decision": "node scripts/bench-decision-model.mjs",
    "test:primitives": "node scripts/test-primitives.mjs",
    "test:mcp:primitives": "node scripts/test-mcp-primitives.mjs",
    "test:mcp:contract": "node scripts/test-mcp-contract.mjs",
    "test:mcp:surface": "node scripts/test-mcp-surface.mjs",
    "test:focus": "node scripts/test-input-focus-independence.mjs",
    "test:cortex:bookmarks": "node scripts/test-bookmarks-search.mjs",
    "test:llm": "node scripts/test-llm-surface.mjs",
    "test:search": "node scripts/test-search-web.mjs",
    "test:crawl": "node scripts/test-deep-crawl.mjs",
    "test:research": "node scripts/test-research-topic.mjs",
    "manual:tools": "node scripts/gen-manual-tools.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "mcp",
    "electron",
    "browser",
    "multimodal",
    "ai-agent",
    "cyberpunk"
  ],
  "author": "HyperbolicTonic <hyperbolictonic@users.noreply.github.com>",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@lancedb/lancedb": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9",
    "jsdom": "^30.1.2",
    "open-jev": "^0.1.2",
    "turndown": "^7.2.4",
    "webm-muxer": "^5.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/turndown": "^5.0.6",
    "daisyui": "^5.7.50",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp",
      "electron-winstaller"
    ]
  }
}
