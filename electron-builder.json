{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hyperbolictonic.kuang-grade-mark-eleven",
  "productName": "Hyperbolic Gateway",
  "copyright": "Copyright © 2026 HyperbolicTonic",
  "publish": [
    {
      "provider": "github",
      "owner": "hyperbolictonic",
      "repo": "kuang-grade-mark-eleven",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "bin/**/*",
    "public/**/*",
    "package.json",
    "!node_modules/@lancedb/lancedb/node_modules/**",
    "!**/.cache/**"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/*.dll",
    "**/*.dylib",
    "**/*.so*",
    "**/@lancedb/**",
    "**/onnxruntime-node/**",
    "**/@img/**",
    "**/sharp/**",
    "bin/**/*"
  ],
  "afterPack": "scripts/verify-pack.cjs",
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "public/assets/mark-eleven.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hyperbolic Gateway // Cyberdeck",
    "include": "scripts/nsis-rebrand.nsh"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "icon": "public/assets/mark-eleven.png",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "icon": "public/assets/mark-eleven.png",
    "category": "Development"
  }
}
